// vertex shader — UV rotation
const vertexShaderSource = `
attribute vec3 a_vertex;
attribute vec3 a_normal;
attribute vec3 a_tangent;
attribute vec2 a_texcoord;

uniform mat4 u_mvp_matrix;
uniform mat4 u_mv_matrix;
uniform mat3 u_normal_matrix;

// rotation params
uniform vec2 u_rot_center;
uniform float u_rot_angle;

varying vec3 v_pos_eye;
varying vec3 v_normal;
varying vec3 v_tangent;
varying vec2 v_texcoord;

vec2 rotate_uv(vec2 uv, vec2 center, float angle) {
    vec2 d = uv - center;
    float c = cos(angle);
    float s = sin(angle);
    return vec2(d.x * c - d.y * s, d.x * s + d.y * c) + center;
}

void main() {
    vec4 pos_eye = u_mv_matrix * vec4(a_vertex, 1.0);
    v_pos_eye = pos_eye.xyz;

    v_normal = u_normal_matrix * a_normal;
    v_tangent = u_normal_matrix * a_tangent;

    v_texcoord = rotate_uv(a_texcoord, u_rot_center, u_rot_angle);

    gl_Position = u_mvp_matrix * vec4(a_vertex, 1.0);
}`;

// fragment shader — phong + normal mapping
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform vec3 u_light_pos;
uniform sampler2D u_tex_diffuse;
uniform sampler2D u_tex_specular;
uniform sampler2D u_tex_normal;

varying vec3 v_pos_eye;
varying vec3 v_normal;
varying vec3 v_tangent;
varying vec2 v_texcoord;

void main() {
    // sample textures
    vec3 diffuse_color = texture2D(u_tex_diffuse, v_texcoord).rgb;
    float specular_intensity = 1.0 - texture2D(u_tex_specular, v_texcoord).r;
    vec3 normal_sample = texture2D(u_tex_normal, v_texcoord).rgb;
    vec3 tangent_normal = normal_sample * 2.0 - 1.0;

    // TBN via Gram-Schmidt
    vec3 N = normalize(v_normal);
    vec3 T = normalize(v_tangent - dot(v_tangent, N) * N);
    vec3 B = cross(N, T);
    mat3 TBN = mat3(T, B, N);
    vec3 mapped_normal = normalize(TBN * tangent_normal);

    // phong lighting
    vec3 L = normalize(u_light_pos - v_pos_eye);
    vec3 V = normalize(-v_pos_eye);
    vec3 R = reflect(-L, mapped_normal);

    float ambient = 0.12;
    float diff = max(dot(mapped_normal, L), 0.0);
    float spec = pow(max(dot(R, V), 0.0), 32.0);

    vec3 ambient_term = ambient * diffuse_color;
    vec3 diffuse_term = diff * 0.7 * diffuse_color;
    vec3 specular_term = spec * 0.6 * vec3(specular_intensity);

    vec3 final_color = ambient_term + diffuse_term + specular_term;

    gl_FragColor = vec4(final_color, 1.0);
}`;
