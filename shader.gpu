// Gouraud shading
const vertexShaderSource = `
attribute vec3 a_vertex;
attribute vec3 a_normal;

uniform mat4 u_mvp_matrix;
uniform mat4 u_mv_matrix;
uniform mat3 u_normal_matrix;
uniform vec3 u_light_pos;

varying vec3 v_color;

void main() {
    gl_Position = u_mvp_matrix * vec4(a_vertex, 1.0);

    vec3 P = (u_mv_matrix * vec4(a_vertex, 1.0)).xyz;
    vec3 L = normalize(u_light_pos - P);
    vec3 N = normalize(u_normal_matrix * a_normal);

    float diff = max(dot(N, L), 0.0);
    float spec = pow(max(dot(reflect(-L, N), vec3(0.0, 0.0, 1.0)), 0.0), 16.0);

    vec3 col = vec3(0.2, 0.6, 0.8);
    vec3 ambient = col * 0.15;
    vec3 diffuse = col * diff * 0.7;
    vec3 specular = vec3(spec * 0.8);
    v_color = min(ambient + diffuse + specular, vec3(1.0));
}`;

// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

varying vec3 v_color;

void main() {
    gl_FragColor = vec4(v_color, 1.0);
}`;
